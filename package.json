{
  "name": "linopress",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@9.12.2",
  "bin": {
    "linopress": "dist/cli.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "test": "tsx --test tests/**/*.test.ts"
  },
  "dependencies": {
    "@sisu-ai/adapter-anthropic": "latest",
    "@sisu-ai/adapter-openai": "latest",
    "@sisu-ai/core": "latest",
    "@sisu-ai/mw-conversation-buffer": "latest",
    "@sisu-ai/mw-control-flow": "latest",
    "@sisu-ai/mw-error-boundary": "latest",
    "@sisu-ai/mw-register-tools": "latest",
    "@sisu-ai/mw-skills": "latest",
    "@sisu-ai/mw-tool-calling": "latest",
    "@sisu-ai/mw-trace-viewer": "latest",
    "dotenv": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.3.3",
    "tsx": "^4.19.2",
    "typescript": "^5.5.4",
    "turbo": "latest"
  }
}
